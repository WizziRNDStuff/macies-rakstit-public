# Cloudflare Pages headers.
#
# The model is a content-hashed file (model.<hash>.json) named in
# digitnet.manifest.json. Cache the hashed model forever (its URL changes only
# when the model changes); keep the manifest revalidated so a retrain is picked
# up promptly. The two path patterns are disjoint (model.* vs digitnet.manifest)
# so Cloudflare never merges their Cache-Control values.
/model.*.json
  Cache-Control: public, max-age=31536000, immutable

/digitnet.manifest.json
  Cache-Control: no-cache
